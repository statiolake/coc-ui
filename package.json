{
  "name": "@statiolake/coc-ui",
  "version": "0.2.0",
  "description": "VS Code-style view containers for coc.nvim extensions",
  "author": "statiolake",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "coc": "^0.0.82"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node esbuild.mjs",
    "prepare": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc --project tsconfig.test.json && node --test .tmp/test/picker/preview.test.js .tmp/test/tree/tree-decoration-model.test.js .tmp/test/tree/native-tree-view.test.js; status=$?; rm -rf .tmp; exit $status"
  },
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ui.showContainer",
        "title": "Show a Coc UI view container"
      },
      {
        "command": "ui.showView",
        "title": "Show a Coc UI view"
      },
      {
        "command": "ui.closeContainer",
        "title": "Close a Coc UI view container"
      },
      {
        "command": "ui.closeLocation",
        "title": "Close a Coc UI workbench surface"
      },
      {
        "command": "ui.togglePrimarySidebar",
        "title": "Toggle Primary Sidebar"
      },
      {
        "command": "ui.toggleSecondarySidebar",
        "title": "Toggle Secondary Sidebar"
      },
      {
        "command": "ui.togglePanel",
        "title": "Toggle Panel"
      },
      {
        "command": "ui.toggleView",
        "title": "Expand or Collapse a Coc UI view"
      },
      {
        "command": "ui.selectActivityBar",
        "title": "Select an Activity Bar view container"
      },
      {
        "command": "ui.switchPrimarySidebar",
        "title": "Switch Primary Sidebar View Container"
      },
      {
        "command": "ui.switchSecondarySidebar",
        "title": "Switch Secondary Sidebar View Container"
      },
      {
        "command": "ui.switchPanel",
        "title": "Switch Panel View Container"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Coc UI",
      "properties": {
        "ui.primarySidebar.position": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left"
        },
        "ui.primarySidebar.width": {
          "type": "number",
          "default": 40,
          "minimum": 10
        },
        "ui.secondarySidebar.position": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right"
        },
        "ui.secondarySidebar.width": {
          "type": "number",
          "default": 40,
          "minimum": 10
        },
        "ui.panel.height": {
          "type": "number",
          "default": 12,
          "minimum": 3
        },
        "ui.activityBar.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show an activity bar for sidebar view containers."
        },
        "ui.activityBar.width": {
          "type": "number",
          "default": 3,
          "minimum": 2
        },
        "ui.mouse.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable native mouse navigation and context menus in Coc UI tree views."
        },
        "ui.tree.indentGuides.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show vertical indent guides for nested items in Coc UI tree views."
        },
        "ui.tree.indentGuides.character": {
          "type": "string",
          "default": "│",
          "description": "Character used for Coc UI tree indent guides."
        },
        "ui.tree.disclosure.collapsed": {
          "type": "string",
          "default": "",
          "description": "Disclosure marker overlay for collapsed collapsible tree items."
        },
        "ui.tree.disclosure.expanded": {
          "type": "string",
          "default": "",
          "description": "Disclosure marker overlay for expanded collapsible tree items."
        },
        "ui.picker.maxItems": {
          "type": "number",
          "default": 10000,
          "minimum": 100,
          "description": "Maximum items retained by a floating picker producer."
        },
        "ui.picker.visibleItems": {
          "type": "number",
          "default": 200,
          "minimum": 20,
          "description": "Maximum items rendered around the current picker selection."
        },
        "ui.picker.preview.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show a side file preview in the floating list picker when the selected item resolves to a local file and the editor is wide enough."
        },
        "ui.picker.preview.minColumns": {
          "type": "number",
          "default": 120,
          "minimum": 40,
          "description": "Minimum editor columns required before the floating list picker mounts a side file preview."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "coc.nvim": "^0.0.83-next.24",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statiolake/ui.git"
  },
  "bugs": {
    "url": "https://github.com/statiolake/coc-ui/issues"
  },
  "homepage": "https://github.com/statiolake/coc-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ]
}
