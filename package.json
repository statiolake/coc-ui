{
  "name": "@statiolake/coc-ui",
  "version": "0.0.0-development",
  "description": "Shared view containers for coc.nvim extensions",
  "author": "statiolake",
  "license": "MIT",
  "main": "lib/index.js",
  "engines": {
    "coc": "^0.0.82"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "prepare": "node esbuild.mjs",
    "typecheck": "tsc --noEmit"
  },
  "activationEvents": ["*"],
  "contributes": {
    "commands": [
      {
        "command": "coc-ui.show",
        "title": "Show a registered Coc view"
      },
      {
        "command": "coc-ui.close",
        "title": "Close the active Coc view"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Coc UI",
      "properties": {
        "coc-ui.sidebar.position": {
          "type": "string",
          "enum": ["left", "right"],
          "default": "left"
        },
        "coc-ui.sidebar.width": {
          "type": "number",
          "default": 40,
          "minimum": 10
        },
        "coc-ui.panel.height": {
          "type": "number",
          "default": 12,
          "minimum": 3
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "coc.nvim": "^0.0.83-next.24",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  }
}

