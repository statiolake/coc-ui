{
  "name": "@statiolake/coc-ui",
  "version": "0.2.0",
  "description": "VS Code-style view containers for coc.nvim extensions",
  "author": "statiolake",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "engines": {
    "coc": "^0.0.82"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node esbuild.mjs",
    "prepare": "node esbuild.mjs",
    "typecheck": "tsc --noEmit"
  },
  "activationEvents": [
    "*"
  ],
  "contributes": {
    "commands": [
      {
        "command": "ui.showContainer",
        "title": "Show a Coc UI view container"
      },
      {
        "command": "ui.showView",
        "title": "Show a Coc UI view"
      },
      {
        "command": "ui.closeContainer",
        "title": "Close a Coc UI view container"
      },
      {
        "command": "ui.closeLocation",
        "title": "Close a Coc UI workbench surface"
      },
      {
        "command": "ui.togglePrimarySidebar",
        "title": "Toggle Primary Sidebar"
      },
      {
        "command": "ui.toggleSecondarySidebar",
        "title": "Toggle Secondary Sidebar"
      },
      {
        "command": "ui.togglePanel",
        "title": "Toggle Panel"
      },
      {
        "command": "ui.toggleView",
        "title": "Expand or Collapse a Coc UI view"
      },
      {
        "command": "ui.selectActivityBar",
        "title": "Select an Activity Bar view container"
      },
      {
        "command": "ui.switchPrimarySidebar",
        "title": "Switch Primary Sidebar View Container"
      },
      {
        "command": "ui.switchSecondarySidebar",
        "title": "Switch Secondary Sidebar View Container"
      },
      {
        "command": "ui.switchPanel",
        "title": "Switch Panel View Container"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Coc UI",
      "properties": {
        "ui.primarySidebar.position": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "left"
        },
        "ui.primarySidebar.width": {
          "type": "number",
          "default": 40,
          "minimum": 10
        },
        "ui.secondarySidebar.position": {
          "type": "string",
          "enum": [
            "left",
            "right"
          ],
          "default": "right"
        },
        "ui.secondarySidebar.width": {
          "type": "number",
          "default": 40,
          "minimum": 10
        },
        "ui.panel.height": {
          "type": "number",
          "default": 12,
          "minimum": 3
        },
        "ui.activityBar.enable": {
          "type": "boolean",
          "default": true,
          "description": "Show an activity bar for sidebar view containers."
        },
        "ui.activityBar.width": {
          "type": "number",
          "default": 3,
          "minimum": 2
        },
        "ui.mouse.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable native mouse navigation and context menus in Coc UI tree views."
        }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^16.18.0",
    "coc.nvim": "^0.0.83-next.24",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statiolake/ui.git"
  },
  "bugs": {
    "url": "https://github.com/statiolake/coc-ui/issues"
  },
  "homepage": "https://github.com/statiolake/coc-ui#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ]
}
